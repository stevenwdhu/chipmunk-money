{
  "name": "spending-tracker",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"pnpm --filter @st/server dev\" \"pnpm --filter @st/web dev\"",
    "build": "pnpm --filter @st/web build && pnpm --filter @st/mcp build && pnpm --filter @st/server build",
    "start": "node apps/server/dist/index.mjs",
    "test": "vitest run",
    "typecheck": "pnpm -r typecheck",
    "seed:demo": "pnpm --filter @st/server seed:demo",
    "db:generate": "pnpm --filter @st/server db:generate",
    "screenshots": "node scripts/screenshots.mjs",
    "docs:update": "pnpm --filter @st/server docs:update",
    "mcp:stdio": "pnpm --silent --filter @st/mcp stdio"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "concurrently": "^10.0.7",
    "playwright-core": "^1.65.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
