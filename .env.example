# Copy to .env. Everything is optional, and the defaults are shown. README → Configuration has the details.
# In Docker, leave DATA_DIR, API_PORT and HOST alone: the image sets them, and compose.yaml chooses the port.

# Server
# Holds meta.db (ledgers and app settings), ledgers/<id>.db, secret.key and backups/. Relative to the repo root.
# DATA_DIR=data
# API_PORT=8787
# 0.0.0.0 listens on every interface (your phone can reach it), 127.0.0.1 on this machine only
# HOST=0.0.0.0
# Time zone used when the in-app setting is left on "System default"
# TZ=America/Toronto

# Security (README → Security)
# Behind a reverse proxy: requests without an API key must also carry this header. Keep the port private to the proxy.
# TRUSTED_AUTH_HEADER=Tailscale-User-Login
# More host names the web app is opened at, comma-separated (a leading dot allows subdomains).
# IP addresses, localhost and local names (.local, .lan, .home.arpa, .internal, .ts.net) always work.
# ALLOWED_HOSTS=money.example.com,.home.example.com

# Optional AI providers (override App settings → AI). Leave them out to set them up in the app.
# AI_PRIMARY_KIND=anthropic            # anthropic | openai | openrouter | gemini | mistral | groq | deepseek | xai | local | openai-compatible
# AI_PRIMARY_MODEL=claude-opus-5-5
# AI_PRIMARY_API_KEY=
# AI_PRIMARY_BASE_URL=
# AI_FALLBACK_KIND=openai-compatible   # BASE_URL is only used by openai-compatible, the others have fixed URLs
# AI_FALLBACK_MODEL=llama3.1
# AI_FALLBACK_API_KEY=
# AI_FALLBACK_BASE_URL=http://192.168.1.20:11434/v1

# Optional Plaid keys for bank sync (override App settings → Bank sync)
# PLAID_CLIENT_ID=
# PLAID_SECRET=
# PLAID_ENV=sandbox                    # sandbox | production (use the matching secret)

# These are read from your shell, not from this file
# The Vite dev server (pnpm dev)
# PORT=5173
# VITE_ALLOWED_HOSTS=my-tunnel.example.com
# The stdio MCP server (pnpm mcp:stdio, apps/mcp/dist/stdio.js)
# ST_API_URL=http://localhost:8787
# ST_API_KEY=st_…
